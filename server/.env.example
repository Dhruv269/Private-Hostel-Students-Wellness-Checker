# ==============================================================================
# HostelWell Backend Environment Configuration Template
# 
# Copy this file to `server/.env` and supply your real Google AI Studio key:
#   cp server/.env.example server/.env
#
# IMPORTANT SECURITY RULES:
# - Do NOT commit your real `server/.env` file.
# - Do NOT paste your API key into Git, chat, or client-side files.
# - Real `.env` files are automatically ignored by .gitignore.
# ==============================================================================

# Server Port (Default 5002; on macOS, port 5000 is reserved by AirPlay Receiver)
PORT=5002

# Allowed Frontend Client Origin for CORS (e.g. your local Vite frontend)
CLIENT_URL=http://localhost:5173

# Google Gemini API Key for accessing hosted Google Gemma models
# Obtain a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace_with_your_own_key

# Configurable Gemma Model Identifier
# MUST be a Google Gemma model (do not substitute non-Gemma models)
# Candidate model: gemma-4-26b-a4b-it
# Verified options: gemma-4-26b-a4b-it, gemma-2-9b-it, gemma-2-27b-it
GEMMA_MODEL_ID=gemma-4-26b-a4b-it
